# FileGuard Environment Configuration Template
FLASK_ENV=development
FLASK_DEBUG=False
SECRET_KEY=generate-a-strong-random-key-for-production
CANONICAL_URL=http://localhost:5000

# Database & Storage
DATABASE_URI=sqlite:///fileguard.db
STORAGE_DIR=storage

# Upload Controls
MAX_CONTENT_LENGTH_MB=100
ALLOWED_EXTENSIONS=pdf,png,jpg,jpeg,txt,csv,docx,xlsx,pptx,zip
EXPIRATION_HOURS=12

# Admin Initial Credentials (Used by init_db.py)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=FileGuard@Sec2026!

# Rate Limiting
RATELIMIT_DEFAULT=100 per minute
RATELIMIT_STORAGE_URI=memory://

